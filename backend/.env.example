APP_NAME=KAMJuridica
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://www.kamjuridica.com

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_ES

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

# Base de datos (MySQL)
DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=kamjuridica
DB_USERNAME=root
DB_PASSWORD=

# Sesiones (driver de base de datos)
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
# En producción con HTTPS, ponlo en true.
SESSION_SECURE_COOKIE=false

# Cola y caché (sin Redis: se usa la base de datos)
QUEUE_CONNECTION=database
CACHE_STORE=database
FILESYSTEM_DISK=local

# Correo del formulario de contacto (smtp en producción)
MAIL_MAILER=smtp
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="contacto@kamjuridica.com"
MAIL_FROM_NAME="${APP_NAME}"

# Proxies de confianza para detectar HTTPS (nginx, Cloudflare, etc.).
# '*' para confiar en todos, o lista separada por comas: 10.0.0.1,10.0.0.0/8
TRUSTED_PROXIES=*
